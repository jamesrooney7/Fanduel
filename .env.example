# This tool needs NO configuration to write a CSV — just run it.
#
# Copy this file to .env only if you want to change a default or use Google
# Sheets:   cp .env.example .env

# The state subdomain to query — use the state you are physically in.
# Examples: nj, pa, mi, il, co, az, ny, va, tn, ks, oh, md, ma, ky, nc, ...
# You can also pass --state on the command line. Default: nj.
#FANDUEL_STATE=nj

# ----- Optional: write to Google Sheets instead of a CSV -----
# Set GOOGLE_SPREADSHEET to a spreadsheet URL or ID and the tool writes there
# instead of a CSV. Requires the one-time service-account setup described in
# the README under "Optional: write to Google Sheets".
#GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json
#GOOGLE_SPREADSHEET=https://docs.google.com/spreadsheets/d/PUT_YOUR_SHEET_ID_HERE/edit

# Only needed if FanDuel ever rotates the public app key its website uses:
#FANDUEL_APP_KEY=FhMFpcPWXMeyZxOx
