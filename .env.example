# Copy this file to .env and fill it in.   cp .env.example .env

# FanDuel state subdomain to query — use the state you are physically in.
# Examples: nj, pa, mi, il, co, az, ny, va, tn, ks, oh, md, ma, ky, nc, ...
FANDUEL_STATE=nj

# Path to your Google service-account key JSON (see README "Google Sheets setup").
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json

# The spreadsheet snapshots are written into — full URL or just the ID.
# The sheet MUST be shared (Editor) with the service account's client_email.
GOOGLE_SPREADSHEET=https://docs.google.com/spreadsheets/d/PUT_YOUR_SHEET_ID_HERE/edit

# Only needed if FanDuel ever rotates the public app key their website uses:
# FANDUEL_APP_KEY=FhMFpcPWXMeyZxOx
